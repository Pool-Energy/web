{
  "name": "poolenergy",
  "version": "1.4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --configuration=production",
    "start:dev": "ng serve --ssl --configuration=development",
    "build": "ng build --configuration=production && gzipper compress --brotli --include js,css,html --brotli-quality 6 ./dist",
    "test": "ng test",
    "test:e2e": "bash scripts/e2e-docker.sh",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "watch": "ng build --watch --configuration=development",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/humanize-duration": "^3.27.4",
    "angular-csv-ext": "^1.0.5",
    "apexcharts": "^8.5.0",
    "bootstrap": "5.3.8",
    "compare-versions": "^6.1.1",
    "filesize": "^9.0.11",
    "humanize-duration": "^3.33.0",
    "ng-apexcharts": "^3.2.0",
    "ng-terminal": "^6.5.0",
    "ngx-cookie-service": "^22.0.0",
    "ngx-filesize": "^3.0.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@types/node": "^26.6.5",
    "gzipper": "^8.3.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 2 Edge major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "Firefox ESR"
  ],
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}
